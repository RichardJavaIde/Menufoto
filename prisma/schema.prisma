generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum ImageFit {
  COVER
  CONTAIN
}

// NUEVO: tipos de diapositiva y efectos de transición del modo TV
enum TvSlideType {
  OFFERS
  POPULAR
  CATEGORY
  GALLERY
}
enum TvEffect {
  FADE
  SLIDE
  ZOOM
  KENBURNS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Image {
  id         String   @id @default(cuid())
  fileKey    String   @unique
  width      Int
  height     Int
  sizeBytes  Int
  // Recorte elegido por el admin, en porcentaje (0-100) sobre la imagen original
  cropX      Float    @default(0)
  cropY      Float    @default(0)
  cropWidth  Float    @default(100)
  cropHeight Float    @default(100)
  // Punto focal para object-position (0-100)
  focalX     Float    @default(50)
  focalY     Float    @default(50)
  fit        ImageFit @default(COVER)
  createdAt  DateTime @default(now())

  dishes  Dish[]
  logoOf  RestaurantSettings[] @relation("Logo")
  coverOf RestaurantSettings[] @relation("Cover")
  tvSlideImages TvSlideImage[]
}

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dishes Dish[]
  tvSlides TvSlide[]

  @@index([sortOrder])
}

model Dish {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  // visible: aparece en la carta. available: si es false se muestra "Agotado".
  visible     Boolean  @default(true)
  available   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // NUEVO: modo TV. La oferta está activa si hay precio de oferta y la fecha actual cae
  // dentro del rango (offerStart y offerEnd son opcionales).
  popular         Boolean   @default(false)
  offerPriceCents Int?
  offerStart      DateTime?
  offerEnd        DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  imageId String?
  image   Image?  @relation(fields: [imageId], references: [id], onDelete: SetNull)

  tags Tag[]

  @@index([categoryId, sortOrder])
}

model Tag {
  id        String  @id @default(cuid())
  name      String  @unique
  icon      String?
  sortOrder Int     @default(0)

  dishes Dish[]
}

model OpeningHour {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0 = domingo ... 6 = sábado
  opensAt   String? // "HH:mm"
  closesAt  String? // "HH:mm"
  closed    Boolean @default(false)

  @@index([dayOfWeek])
}

model RestaurantSettings {
  id             Int     @id @default(1)
  name           String  @default("Mi Restaurante")
  tagline        String?
  description    String?
  address        String?
  phone          String?
  whatsapp       String?
  email          String?
  instagram      String?
  facebook       String?
  website        String?
  currencyCode   String  @default("DOP")
  currencySymbol String  @default("RD$")

  // NUEVO: zona horaria para los horarios del modo TV
  timezone String @default("America/Santo_Domingo")

  logoId  String?
  logo    Image?  @relation("Logo", fields: [logoId], references: [id], onDelete: SetNull)
  coverId String?
  cover   Image?  @relation("Cover", fields: [coverId], references: [id], onDelete: SetNull)

  // Apariencia: tema elegido y personalizaciones opcionales
  themeId         String  @default("elegante")
  colorPrimary    String?
  colorAccent     String?
  colorBackground String?
  colorText       String?
  fontHeading     String?
  fontBody        String?

  updatedAt DateTime @updatedAt
}

// NUEVO: una pantalla de TV. Se abre en /tv/<token>; el token hace de llave.
model TvScreen {
  id         String    @id @default(cuid())
  name       String
  token      String    @unique
  active     Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  slides TvSlide[]
}

// NUEVO: una diapositiva de la lista de una pantalla
model TvSlide {
  id       String      @id @default(cuid())
  screenId String
  screen   TvScreen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  type     TvSlideType
  position Int         @default(0)
  // Segundos en pantalla. En GALLERY es el tiempo de cada imagen.
  seconds  Int         @default(10)
  effect   TvEffect    @default(FADE)
  active   Boolean     @default(true)

  // Horario (opcional). days: bits 0 = domingo ... 6 = sábado. Minutos desde medianoche.
  // Todo en null = siempre se muestra.
  days        Int?
  startMinute Int?
  endMinute   Int?

  // Solo para CATEGORY
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Solo para GALLERY
  title  String?
  text   String?
  images TvSlideImage[]

  @@index([screenId, position])
}

// NUEVO: imágenes de una diapositiva GALLERY (pasarela)
model TvSlideImage {
  id       String  @id @default(cuid())
  slideId  String
  slide    TvSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
  imageId  String
  image    Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  position Int     @default(0)

  @@index([slideId, position])
}